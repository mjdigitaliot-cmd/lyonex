# App
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lyonex?schema=public

# Store defaults
STORE_NAME=LYONEX
STORE_CURRENCY=INR
STORE_COUNTRY=IN
STORE_TIMEZONE=Asia/Kolkata

# Notifications (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# Object storage (optional)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
